{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "backend",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-10",
    "observability": {
        "enabled": true
    },
    "upload_source_maps": true,
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "movie-portal-db",
            "database_id": ""
        }
    ]
}